<Window x:Class="Winside.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Winside - Gerenciador de Instalação do Windows 11"
        Height="680" Width="960"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>  <!-- Main Area (Sidebar + Content) -->
            <RowDefinition Height="26"/> <!-- Compact Status Bar -->
        </Grid.RowDefinitions>

        <!-- Main Body: Sidebar + Views -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/> <!-- Icon-Only Minimalist Sidebar -->
                <ColumnDefinition Width="*"/>  <!-- Content Area -->
            </Grid.ColumnDefinitions>

            <!-- Minimalist Icon Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Nav Icons -->
                        <RowDefinition Height="Auto"/> <!-- Footer: Lang Toggle, Portfolio & Admin -->
                    </Grid.RowDefinitions>

                    <!-- Navigation Icons -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <!-- 1. Hardware Compatibility Audit -->
                        <RadioButton x:Name="NavCompatibility" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Click="NavButton_Click" ToolTip="Auditoria de Hardware">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M4 4h16v16H4V4zm2 2v12h12V6H6zm3 3h6v6H9V9zm-5 2H2v2h2v-2zm0 4H2v2h2v-2zm0-8H2v2h2V7zm16 4h2v2h-2v-2zm0 4h2v2h-2v-2zm0-8h2v2h-2V7zM7 2h2v2H7V2zm4 0h2v2h-2V2zm4 0h2v2h-2V2zM7 20h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z"/>
                        </RadioButton>

                        <!-- 2. Bypasses & Registry -->
                        <RadioButton x:Name="NavBypasses" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" ToolTip="Bypasses e Registro">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                        </RadioButton>

                        <!-- 3. ISO Manager & Installer -->
                        <RadioButton x:Name="NavInstaller" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" ToolTip="ISO e Instalação">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-12.5c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zm0 6c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                        </RadioButton>

                        <!-- 4. Console & Diagnostics -->
                        <RadioButton x:Name="NavLogs" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" ToolTip="Diagnósticos e Logs">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zm-12-3l3.5-3.5L8 8l1.4-1.4 4.9 4.9-4.9 4.9L8 15zm6 0h4v2h-4v-2z"/>
                        </RadioButton>
                    </StackPanel>

                    <!-- Footer: Language Toggle, Portfolio Link & Admin Icon -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <!-- Language Toggle Button (PT / EN) -->
                        <Button x:Name="BtnLangToggle" Style="{StaticResource SidebarIconButton}" Click="BtnLangToggle_Click" ToolTip="Alternar Idioma / Switch Language (PT-BR / EN)">
                            <Border Background="#1A2234" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2">
                                <TextBlock x:Name="TxtLangCode" Text="PT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Button>

                        <!-- Portfolio Icon Button -->
                        <Button x:Name="BtnPortfolio" Style="{StaticResource SidebarIconButton}" Click="BtnPortfolio_Click" ToolTip="Portfólio (https://emirln.com)">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                        </Button>

                        <!-- Admin Shield Access Icon -->
                        <Border x:Name="BadgeAdminIcon" Width="36" Height="36" Background="Transparent" CornerRadius="6" ToolTip="Executando com Privilégios de Administrador" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource SuccessBrush}"
                                      Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v6h-2V7zm0 8h2v2h-2v-2z"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="22,18">
                
                <!-- VIEW 1: Auditoria de Hardware -->
                <Grid x:Name="ViewCompatibility" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Resumo Geral -->
                            <Border Style="{StaticResource Win11CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCompatTitle" Text="Avaliação de Compatibilidade do Sistema" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtEvaluationSummary" Text="Analisando compatibilidade do hardware..." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRefreshAudit" Grid.Column="1" Content="Refazer Auditoria" Style="{StaticResource Win11PrimaryButtonStyle}" Click="BtnRefreshAudit_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Processador e Instruções -->
                            <Border Style="{StaticResource Win11CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtProcSection" Text="Processador e Suporte a Instruções" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblCpuName" Text="Processador:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtCpuName" Text="Detectando..." FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="LblSse42" Text="Instrução SSE4.2:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <Border x:Name="BadgeSse42" Background="#1C2538" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtSse42" Text="VERIFICANDO..." FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="LblPopcnt" Text="Instrução POPCNT:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <Border x:Name="BadgePopcnt" Background="#1C2538" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtPopcnt" Text="VERIFICANDO..." FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="LblFirmware" Text="Tipo de Firmware:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtFirmware" Text="Detectando..." FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Segurança e Recursos -->
                            <Border Style="{StaticResource Win11CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSecuritySection" Text="Segurança e Especificações de Hardware" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="LblTpm" Grid.Row="0" Grid.Column="0" Text="Módulo TPM:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTpm" Text="Detectando..." FontWeight="SemiBold" Margin="0,5"/>

                                        <TextBlock x:Name="LblSecureBoot" Grid.Row="0" Grid.Column="2" Text="Inicialização Segura:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtSecureBoot" Text="Detectando..." FontWeight="SemiBold" Margin="0,5"/>

                                        <TextBlock x:Name="LblRam" Grid.Row="1" Grid.Column="0" Text="Memória RAM:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRam" Text="Detectando..." FontWeight="SemiBold" Margin="0,5"/>

                                        <TextBlock x:Name="LblDisk" Grid.Row="1" Grid.Column="2" Text="Espaço em Disco:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtDiskSpace" Text="Detectando..." FontWeight="SemiBold" Margin="0,5"/>

                                        <TextBlock x:Name="LblOs" Grid.Row="2" Grid.Column="0" Text="Sistema Operacional:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtOsVersion" Text="Detectando..." FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 2: Bypasses e Registro -->
                <Grid x:Name="ViewBypasses" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Win11CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBypassTitle" Text="Bypasses de Compatibilidade do Windows 11" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtBypassDesc" Text="Aplique as chaves de registro abaixo para contornar verificações de hardware durante a instalação ou atualização." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                    <CheckBox x:Name="ChkTPM" Content="Ignorar verificação de TPM 2.0 (LabConfig\BypassTPMCheck)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkSecureBoot" Content="Ignorar verificação de Inicialização Segura / Secure Boot (LabConfig\BypassSecureBootCheck)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkRAM" Content="Ignorar verificação de Memória RAM mínima (LabConfig\BypassRAMCheck)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkCPU" Content="Ignorar verificação de Modelo e Geração de CPU (LabConfig\BypassCPUCheck)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkStorage" Content="Ignorar verificação de Tamanho Mínimo de Disco (LabConfig\BypassStorageCheck)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkMoSetup" Content="Permitir Atualização Direta com TPM ou CPU incompatíveis (MoSetup\AllowUpgradesWithUnsupportedTPMOrCPU)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkBypassNro" Content="Ignorar exigência de Conta Microsoft (MSA) no OOBE (OOBE\BypassNRO)" IsChecked="True"/>

                                    <Border Background="{StaticResource BorderSubtleBrush}" Height="1" Margin="0,16"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnApplyBypasses" Content="Aplicar Bypasses" Style="{StaticResource Win11PrimaryButtonStyle}" Click="BtnApplyBypasses_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnVerifyRegistry" Content="Verificar Registro Ativo" Style="{StaticResource Win11SecondaryButtonStyle}" Click="BtnVerifyRegistry_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnResetBypasses" Content="Restaurar Padrões / Limpar" Style="{StaticResource Win11DangerButtonStyle}" Click="BtnResetBypasses_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Win11CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtGuidanceTitle" Text="Orientações e Requisitos do Windows 11" FontSize="13" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtGuidance1" Text="• Para atualizar máquinas não suportadas mantendo programas e arquivos intactos, o 'Modo Servidor' (/product server) executa o instalador ignorando os bloqueios de compatibilidade com alta estabilidade." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtGuidance2" Text="• A partir do Windows 11 24H2, o processador exige compulsoriamente suporte às instruções SSE4.2 e POPCNT em nível de microcódigo." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 3: Gerenciador de ISO e Instalador -->
                <Grid x:Name="ViewInstaller" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Etapa 1: Seleção de ISO -->
                            <Border Style="{StaticResource Win11CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtStep1Title" Text="Etapa 1: Selecionar Arquivo ISO do Windows 11" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Button x:Name="BtnDownloadIso" Grid.Column="1" Content="Baixar ISO Oficial da Microsoft" Style="{StaticResource Win11SecondaryButtonStyle}" Click="BtnDownloadIso_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="LblIsoPath" Text="Caminho do arquivo ISO:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtIsoPath" Text="" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnBrowseIso" Grid.Column="1" Content="Procurar ISO..." Style="{StaticResource Win11SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnBrowseIso_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="LblExtractDest" Text="Pasta de Destino da Extração:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtExtractDest" Text="" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnBrowseDest" Grid.Column="1" Content="Procurar Pasta..." Style="{StaticResource Win11SecondaryButtonStyle}" Margin="8,0,0,0" Click="BtnBrowseDest_Click"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="BtnExtractIso" Content="Montar e Extrair ISO" Style="{StaticResource Win11PrimaryButtonStyle}" Click="BtnExtractIso_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnCancelExtract" Content="Cancelar Extração" Style="{StaticResource Win11SecondaryButtonStyle}" Click="BtnCancelExtract_Click" IsEnabled="False"/>
                                    </StackPanel>

                                    <!-- Progresso de Extração -->
                                    <StackPanel Margin="0,8,0,0" x:Name="ExtractProgressPanel" Visibility="Collapsed">
                                        <ProgressBar x:Name="ExtractProgressBar" Value="0" Maximum="100"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtExtractStatus" Text="Extraindo arquivos..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtExtractPercent" Text="0%" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Etapa 2: Execução do Setup -->
                            <Border Style="{StaticResource Win11CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStep2Title" Text="Etapa 2: Iniciar Instalação do Windows 11" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    
                                    <RadioButton x:Name="RbServerMode" Content="Modo Servidor (Recomendado: comando /product server para contornar verificações)" IsChecked="True"/>
                                    <RadioButton x:Name="RbStandardMode" Content="Modo Padrão (Assistente padrão do Windows 11 sem parâmetros adicionais)"/>
                                    <RadioButton x:Name="RbCustomMode" Content="Parâmetros Personalizados:"/>
                                    <TextBox x:Name="TxtCustomArgs" Text="/auto upgrade /quiet" Margin="28,2,0,12" IsEnabled="{Binding IsChecked, ElementName=RbCustomMode}"/>

                                    <Button x:Name="BtnLaunchSetup" Content="Iniciar Instalação do Windows 11" Style="{StaticResource Win11PrimaryButtonStyle}" Click="BtnLaunchSetup_Click" Margin="0,4,0,0" Height="38"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 4: Logs e Diagnósticos -->
                <Grid x:Name="ViewLogs" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Win11CardStyle}" Padding="10" Background="#0D111A">
                        <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,2">
                                        <TextBlock Text="[" Foreground="{StaticResource TextTertiaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Text="{Binding FormattedTime}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Text="] " Foreground="{StaticResource TextTertiaryBrush}" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{Binding LevelColor}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnCopyLogs" Content="Copiar Todos os Logs" Style="{StaticResource Win11SecondaryButtonStyle}" Click="BtnCopyLogs_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnOpenLogFile" Content="Abrir Log no Bloco de Notas" Style="{StaticResource Win11SecondaryButtonStyle}" Click="BtnOpenLogFile_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnClearLogs" Content="Limpar Console" Style="{StaticResource Win11SecondaryButtonStyle}" Click="BtnClearLogs_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtGlobalStatus" Text="Pronto." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Emir Tech Tools • emirln.com" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
